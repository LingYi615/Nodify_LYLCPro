<UserControl x:Class="LYCorePro.Views.ToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
             xmlns:core="clr-namespace:LYCorePro.Core"
             xmlns:shared="clr-namespace:Nodify;assembly=Nodify.Shared"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:converters="clr-namespace:LYCorePro.Converters"
             x:Name="ToolboxControl">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:InverseStringToVisibilityConverter x:Key="InverseStringToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <!-- 分类模板 -->
        <HierarchicalDataTemplate DataType="{x:Type core:ToolboxCategory}" 
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2">
                <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Children.Count, StringFormat= ({0})}" 
                           FontSize="11" Foreground="Gray" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- 操作模板 -->
        <DataTemplate DataType="{x:Type core:ToolboxOperation}">
            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="4,2"
                    Background="Transparent" 
                    ToolTip="拖拽到编辑器中添加"
                    x:Name="OperationBorder">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Width="16" Height="16"
                          Data="{Binding Icon}" Fill="#FF007ACC"
                          Stretch="Uniform" Margin="6,0,4,0"
                          VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="Normal" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Description}" FontSize="11" 
                                   Foreground="#666666" TextTrimming="CharacterEllipsis"
                                   MaxWidth="150"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                        <Path Width="14" Height="14" Fill="#4CAF50"
                              Data="{StaticResource Icon_Import}"             
                              Stretch="Uniform" Margin="6,0,4,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding InputCount}" FontSize="11" 
                                   VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <Path Width="14" Height="14" Fill="#FF007ACC"
                              Data="{StaticResource Icon_Export}"             
                              Stretch="Uniform" Margin="6,0,4,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding OutputCount}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F5F5F5" Padding="5" 
                BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, ElementName=ToolboxControl}"
                         Margin="0,0,5,0" Padding="5" FontSize="13"
                         Background="White" BorderBrush="#CCC"
                         Foreground="#222222">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Grid>
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="1" CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ScrollViewer x:Name="PART_ContentHost" 
                                                                  Margin="5,0"
                                                                  Grid.Column="0"/>
                                                    <TextBlock Grid.Column="0" 
                                                               Text="🔍 搜索插件模块..." 
                                                               Foreground="#999" 
                                                               Margin="5,0" VerticalAlignment="Center"
                                                               Visibility="{Binding Text, 
                                                                   RelativeSource={RelativeSource TemplatedParent}, 
                                                                   Converter={StaticResource StringToVisibilityConverter}}"/>
                                                    <Button Grid.Column="1" 
                                                            Background="Transparent"
                                                            BorderThickness="0" 
                                                            Width="28" Height="28" 
                                                            Padding="2"
                                                            Command="{Binding ClearSearchCommand, ElementName=ToolboxControl}"
                                                            Visibility="{Binding Text, 
                                                                RelativeSource={RelativeSource AncestorType=TextBox}, 
                                                                Converter={StaticResource InverseStringToVisibilityConverter}}">
                                                        <Path Data="M559.786667 505.173333 L754.346667 310.613333 C767.999999 296.960000 767.999999 276.480000 754.346667 262.826667 C740.693334 249.173334 720.213334 249.173334 706.560000 262.826667 L512 457.386667 L317.44 262.826667 C303.786667 249.173334 283.306667 249.173334 269.653333 262.826667 C256.000000 276.480000 256.000000 296.960000 269.653333 310.613333 L464.213333 505.173333 L269.653333 699.733333 C256.000000 713.386667 256.000000 733.866667 269.653333 747.520000 C283.306667 761.173333 303.786667 761.173333 317.44 747.520000 L512 552.960000 L706.56 747.520000 C720.213334 761.173333 740.693334 761.173333 754.346667 747.520000 C767.999999 733.866667 767.999999 713.386667 754.346667 699.733333 L559.786667 505.173333 Z"
                                                                  Fill="#FF6B00"
                                                                  Stretch="Uniform"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </Border>

        <TreeView x:Name="ToolboxTree" 
                  ItemsSource="{Binding FilteredCategories, ElementName=ToolboxControl}"
                  BorderThickness="0" Background="White"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  AllowDrop="True">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="Padding" Value="2,4"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="AllowDrop" Value="True"/>
                </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
            </TreeView.Resources>
        </TreeView>

    </DockPanel>
</UserControl>