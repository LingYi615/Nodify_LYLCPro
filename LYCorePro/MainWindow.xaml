<mahapps:MetroWindow
    x:Class="LYCorePro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mahapps="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:LYCorePro.Views"
        xmlns:converters="clr-namespace:LYCorePro.Converters"
        Title="插件系统" WindowState="Maximized"  ResizeMode="CanResize"
        Background="{DynamicResource NodifyEditor.BackgroundBrush}">

    <mahapps:MetroWindow.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <Style x:Key="CustomMinMaxButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="45" />
            <Setter Property="Height" Value="45" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF4A6B9C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF2A4A7C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CustomCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="45" />
            <Setter Property="Height" Value="45" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#E81123" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#BF0F1A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#8A0E15" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mahapps:MetroWindow.Resources>
    <mahapps:MetroWindow.WindowButtonCommands>
        <mahapps:WindowButtonCommands>
            <mahapps:WindowButtonCommands.Style>
                <Style TargetType="mahapps:WindowButtonCommands">
                    <Setter Property="LightMinButtonStyle" Value="{StaticResource CustomMinMaxButtonStyle}" />
                    <Setter Property="LightMaxButtonStyle" Value="{StaticResource CustomMinMaxButtonStyle}" />
                    <Setter Property="LightCloseButtonStyle" Value="{StaticResource CustomCloseButtonStyle}" />
                </Style>
            </mahapps:WindowButtonCommands.Style>
        </mahapps:WindowButtonCommands>
    </mahapps:MetroWindow.WindowButtonCommands>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#1E1E2E" BorderBrush="#313244" 
                BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="保存项目" Click="OnSaveProject"
                        Height="28" Width="80" FontSize="12"
                        Background="#89B4FA" Foreground="#1E1E2E"
                       BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                        IsEnabled="{Binding DataContext.CanNavigateBack, ElementName=Editor, Converter={StaticResource InverseBooleanConverter}}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="LoadButton" Content="加载项目" Click="OnLoadProject"
                        Height="28" Width="80" FontSize="12"
                        Background="#A6E3A1" Foreground="#1E1E2E"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="ExecuteAllButton" Content="执行一次" Click="OnExecuteAll"
                        Height="28" Width="80" FontSize="12"
                        Background="#F9E2AF" Foreground="#1E1E2E"
                        BorderThickness="0" Cursor="Hand" Margin="8,0,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- 编辑器区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    BorderBrush="#DDD" 
                    BorderThickness="0,0,1,0" 
                    Background="#FAFAFA">
                <views:ToolboxView x:Name="ToolboxView"/>
            </Border>

            <views:NodifyEditorView x:Name="Editor" 
                                    Grid.Column="1"
                                    AllowDrop="True"
                                    HasCustomContextMenu="True"/>
        </Grid>
    </Grid>
    </mahapps:MetroWindow>